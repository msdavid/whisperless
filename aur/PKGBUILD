# Maintainer: Mauro <mauro@sauco.net>
pkgname=whisperless
pkgver=0.2.0
pkgrel=1
pkgdesc="Push-to-talk voice dictation for Linux desktops - local R2T2 ASR on your NVIDIA GPU"
arch=('any')
url="https://github.com/msdavid/whisperless"
license=('MIT' 'Apache')
depends=('python' 'python-websockets' 'libnotify')
optdepends=('wtype: key-typing fallback on Wayland for apps without input-method support (recommended)'
            'ydotool: key typing via uinput, the only typer on KDE/GNOME (needs ydotoold daemon)'
            'xdotool: key typing on X11'
            'pipewire: mic capture via pw-record (recommended)'
            'alsa-utils: mic capture fallback (arecord)'
            'playerctl: pause playing media while recording (PAUSE_MEDIA)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('96db1de24998421a36605715a6fdde22e828369386557d0692fbeeef19091db3')

# NOTE: this package ships the client + user service unit + docs only.
# The ASR server (R2T2 checkout, venv, ~4GB model) is not packaged; set it up
# with the repo's install.sh (default layout: ~/apps/r2t2/Confucius4-R2T2),
# then: systemctl --user daemon-reload && systemctl --user enable --now whisperless

package() {
  cd "$pkgname-$pkgver"

  # client (system python)
  install -Dm755 whisperless "$pkgdir/usr/bin/whisperless"
  sed -i '1s|^.*$|#!/usr/bin/python3|' "$pkgdir/usr/bin/whisperless"
  install -Dm644 whisperless_input.py "$pkgdir/usr/lib/whisperless/whisperless_input.py"

  # user service unit, rendered for the default server layout
  install -d "$pkgdir/usr/lib/systemd/user"
  sed -e 's|@SERVER_DIR@|%h/apps/r2t2/Confucius4-R2T2|g' \
      -e 's|@BIND_IP@|127.0.0.1|g' \
      -e 's|@PORT@|8272|g' \
      -e 's|@GPU_INDEX@|0|g' \
      -e 's|@GPU_MEM_UTIL@|0.55|g' \
      -e 's|@MAX_MODEL_LEN@|8192|g' \
      whisperless.service > "$pkgdir/usr/lib/systemd/user/whisperless.service"

  # docs, config example, licenses
  install -Dm644 whisperless.conf "$pkgdir/usr/share/doc/whisperless/whisperless.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/whisperless/README.md"
  install -Dm644 llms.txt "$pkgdir/usr/share/doc/whisperless/llms.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/whisperless/LICENSE"
  install -Dm644 server/NOTICE "$pkgdir/usr/share/licenses/whisperless/NOTICE"
  install -Dm644 server/LICENSE "$pkgdir/usr/share/licenses/whisperless/server-LICENSE-Apache-2.0"
}
