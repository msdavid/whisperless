pkgbase = whisperless
	pkgdesc = Push-to-talk voice dictation for Linux desktops - local R2T2 ASR on your NVIDIA GPU
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/msdavid/whisperless
	arch = any
	license = MIT
	license = Apache
	depends = python
	depends = python-websockets
	depends = libnotify
	optdepends = wtype: key-typing fallback on Wayland for apps without input-method support (recommended)
	optdepends = ydotool: key typing via uinput, the only typer on KDE/GNOME (needs ydotoold daemon)
	optdepends = xdotool: key typing on X11
	optdepends = pipewire: mic capture via pw-record (recommended)
	optdepends = alsa-utils: mic capture fallback (arecord)
	optdepends = playerctl: pause playing media while recording (PAUSE_MEDIA)
	source = whisperless-0.2.0.tar.gz::https://github.com/msdavid/whisperless/archive/refs/tags/v0.2.0.tar.gz
