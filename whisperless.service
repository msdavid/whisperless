[Unit]
Description=R2T2 streaming ASR websocket server (Confucius4-R2T2)
After=graphical-session.target

[Service]
WorkingDirectory=@SERVER_DIR@
ExecStart=@SERVER_DIR@/.venv/bin/python @SERVER_DIR@/ws_server.py -m @SERVER_DIR@/models/Confucius4-R2T2 -ip @BIND_IP@ -p @PORT@
Environment=CUDA_VISIBLE_DEVICES=@GPU_INDEX@
Environment=GPU_MEM_UTIL=@GPU_MEM_UTIL@
Environment=MAX_MODEL_LEN=@MAX_MODEL_LEN@
Environment=CHUNK_SIZE_MS=@CHUNK_SIZE_MS@
Environment=LOOKAHEAD_MS=@LOOKAHEAD_MS@
Environment=UNFIX_TOKEN_NUM=@UNFIX_TOKEN_NUM@
Environment=ROLLBACK_PUNCTUATION=@ROLLBACK_PUNCTUATION@
Environment=MAX_NEW_TOKENS=@MAX_NEW_TOKENS@
Environment=TEMPERATURE=@TEMPERATURE@
Environment=REPETITION_PENALTY=@REPETITION_PENALTY@
Environment=MAX_NUM_SEQS=@MAX_NUM_SEQS@
Environment=KV_CACHE_DTYPE=@KV_CACHE_DTYPE@
Environment=MAX_NUM_BATCHED_TOKENS=@MAX_NUM_BATCHED_TOKENS@
Environment=VAD_SPEECH_THRESHOLD=@VAD_SPEECH_THRESHOLD@
Environment=VAD_MIN_SPEECH_FRAME=@VAD_MIN_SPEECH_FRAME@
Environment=VAD_MAX_SPEECH_FRAME=@VAD_MAX_SPEECH_FRAME@
Environment=VAD_MIN_SILENCE_FRAME=@VAD_MIN_SILENCE_FRAME@
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target